# Copia este archivo a .env y rellena lo que tengas. .env no se sube a git.

# Obligatoria para que los agentes de IA trabajen (https://console.anthropic.com).
ANTHROPIC_API_KEY=

# Opcional: datos reales de YouTube (vistas, likes) para el investigador.
# Google Cloud Console -> habilitar "YouTube Data API v3" -> Credenciales -> API key.
YOUTUBE_API_KEY=
# País para las búsquedas de YouTube (código ISO de 2 letras).
YOUTUBE_REGION=MX

# Opcionales
# PORT=5180
# HOST=127.0.0.1           # 0.0.0.0 para abrirla desde el iPhone en tu red (sin login: solo en redes de confianza)
# FACTORY_MODEL=claude-opus-5-5
# FACTORY_MAX_ATTEMPTS=3   # intentos por tarea antes de marcarla como fallida
# FACTORY_CONCURRENCY=2    # tareas en paralelo (entre producciones distintas)
# FACTORY_MAX_SEARCHES=6   # búsquedas web por investigación
# FACTORY_LLM=mock         # SOLO desarrollo: datos de prueba, sin IA real
